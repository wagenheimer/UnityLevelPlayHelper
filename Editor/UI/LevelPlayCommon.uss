/* LevelPlayHelper Common UI Toolkit Stylesheet */

.lp-root {
    flex-grow: 1;
    padding: 10px 12px;
}

/* Header */
.lp-header {
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.lp-header-row {
    flex-direction: row;
    align-items: center;
}

.lp-header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #e6e6e6;
}

.lp-header-version {
    font-size: 11px;
    color: #999999;
    margin-left: 8px;
    padding: 1px 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

.lp-header-subtitle {
    font-size: 11px;
    color: #aaaaaa;
    margin-top: 4px;
    white-space: normal;
}

.lp-toolbar-actions {
    flex-direction: row;
    align-items: center;
}

.lp-toolbar-btn {
    height: 22px;
    padding: 0 8px;
    font-size: 11px;
    margin-left: 4px;
    border-radius: 3px;
}

/* Tab Bar */
.lp-tab-bar {
    flex-direction: row;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 3px;
}

.lp-tab-button {
    flex-grow: 1;
    height: 28px;
    border-radius: 4px;
    border-width: 0;
    background-color: transparent;
    color: #bbbbbb;
    font-size: 12px;
    -unity-font-style: bold;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.lp-tab-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}

.lp-tab-button--active {
    background-color: rgba(41, 128, 185, 0.45);
    color: #ffffff;
    border-bottom-width: 2px;
    border-bottom-color: #3498db;
}

/* Card */
.lp-card {
    background-color: rgba(0, 0, 0, 0.18);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 8px;
}

.lp-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.lp-card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #e0e0e0;
}

.lp-card-subtitle {
    font-size: 11px;
    color: #9e9e9e;
    white-space: normal;
    margin-bottom: 8px;
}

/* Badges */
.lp-badge {
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
    -unity-font-style: bold;
}

.lp-badge--ok {
    background-color: rgba(46, 125, 50, 0.25);
    color: #81c784;
    border-width: 1px;
    border-color: rgba(76, 175, 80, 0.5);
}

.lp-badge--warn {
    background-color: rgba(245, 124, 0, 0.25);
    color: #ffb74d;
    border-width: 1px;
    border-color: rgba(255, 152, 0, 0.5);
}

.lp-badge--fail {
    background-color: rgba(198, 40, 40, 0.25);
    color: #e57373;
    border-width: 1px;
    border-color: rgba(244, 67, 54, 0.5);
}

.lp-badge--info {
    background-color: rgba(2, 119, 189, 0.25);
    color: #4fc3f7;
    border-width: 1px;
    border-color: rgba(3, 169, 244, 0.5);
}

/* Field Row */
.lp-field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.lp-field-label {
    width: 180px;
    font-size: 11.5px;
    color: #cccccc;
}

.lp-field-input {
    flex-grow: 1;
    margin-right: 6px;
}

.lp-field-status {
    width: 22px;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.lp-field-help {
    font-size: 10.5px;
    color: #888888;
    margin-left: 180px;
    margin-bottom: 6px;
    white-space: normal;
}

/* Platform Switch */
.lp-platform-tabs {
    flex-direction: row;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    padding: 2px;
}

.lp-platform-tab {
    flex-grow: 1;
    height: 24px;
    border-radius: 3px;
    border-width: 0;
    background-color: transparent;
    font-size: 11.5px;
    color: #aaaaaa;
}

.lp-platform-tab--active {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    -unity-font-style: bold;
}

/* Banner Preset Visualizer */
.lp-preset-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

/* Actions */
.lp-actions-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    flex-wrap: wrap;
}

.lp-action-btn {
    height: 26px;
    padding: 0 12px;
    margin-right: 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    font-size: 11.5px;
}

.lp-action-btn--primary {
    background-color: rgba(41, 128, 185, 0.6);
    color: #ffffff;
    -unity-font-style: bold;
}

.lp-action-btn--primary:hover {
    background-color: rgba(52, 152, 219, 0.8);
}

/* Callout Box */
.lp-callout {
    padding: 8px 12px;
    border-radius: 4px;
    margin-bottom: 8px;
    border-left-width: 4px;
}

.lp-callout--info {
    background-color: rgba(2, 119, 189, 0.12);
    border-left-color: #03a9f4;
}

.lp-callout--warn {
    background-color: rgba(245, 124, 0, 0.12);
    border-left-color: #ff9800;
}

.lp-callout--fail {
    background-color: rgba(198, 40, 40, 0.12);
    border-left-color: #f44336;
}

.lp-callout-text {
    font-size: 11px;
    color: #dcdcdc;
    white-space: normal;
}

/* Log Box */
.lp-log-box {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 6px 8px;
    max-height: 180px;
}

.lp-log-line {
    font-size: 10px;
    color: #aaaaaa;
    white-space: normal;
    margin-bottom: 2px;
}

/* Table Row */
.lp-table-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    border-radius: 4px;
    margin-bottom: 3px;
    background-color: rgba(255, 255, 255, 0.03);
}

.lp-table-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

/* Step Item */
.lp-step-item {
    font-size: 11px;
    color: #bbbbbb;
    white-space: normal;
    margin-bottom: 4px;
    margin-left: 4px;
}

